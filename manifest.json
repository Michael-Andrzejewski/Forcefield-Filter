{
  "manifest_version": 3,
  "name": "Forcefield",
  "version": "1.0",
  "description": "Blocks internet toxicity using AI.",
  "permissions": ["activeTab", "scripting", "storage", "notifications"],
  "host_permissions": ["https://api.anthropic.com/*", "<all_urls>"],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
} 