{
  "manifest_version": 3,
  "name": "Forcefield",
  "version": "1.6",
  "description": "Blocks internet toxicity using AI.",
  "permissions": ["activeTab", "scripting", "storage", "notifications"],
  "host_permissions": ["https://api.anthropic.com/*", "https://generativelanguage.googleapis.com/*", "<all_urls>"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://twitter.com/*", "https://*.twitter.com/*", "https://x.com/*", "https://*.x.com/*"],
      "js": ["twitterTracker.js"],
      "run_at": "document_idle"
    }
  ]
} 